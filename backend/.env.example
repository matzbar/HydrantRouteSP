# Copie para backend/.env e ajuste. Todas as variáveis são opcionais.

# Cache de coordenadas obtidas pelo endereço (sem ela, o cache fica só na memória).
MONGO_URL=mongodb://localhost:27017
DB_NAME=hydrantroute

# Só se o frontend for hospedado em outro domínio (separe por vírgula).
# CORS_ORIGINS=https://meu-frontend.exemplo.com

# Servidor OSRM (tempos de carro). O público é para uso leve; troque por um próprio ou comercial se precisar.
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TABLE_MAX=100

# Limite de requisições por minuto por IP.
# RATE_LIMIT_PER_MIN=120
# ROUTE_RATE_LIMIT_PER_MIN=20

# IP do usuário para o limite de requisições. No Render (detectado sozinho) usa o CF-Connecting-IP da Cloudflare.
# Atrás de um proxy que escreve o IP num cabeçalho próprio, informe-o aqui (ex.: x-real-ip).
# CLIENT_IP_HEADER=
# Alternativa: proxies confiáveis que acrescentam IPs ao X-Forwarded-For (local/VPS sem proxy: 0; um Nginx: 1).
# TRUSTED_PROXY_HOPS=0

# Mapa de fundo: chave do MapTiler (restrita por origem no painel do MapTiler). Sem ela, OpenStreetMap.
# MAPTILER_KEY=
# MAPTILER_STYLE=streets-v2
